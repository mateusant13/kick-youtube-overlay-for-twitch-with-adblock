# Chrome extension dev artifacts
_metadata/

# Node
node_modules/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Local backups / temp
backup-*/
ko-guest*.log

# Generated verification receipts (regenerate with _tools/ko-verify.mjs)
_evidence/

# Generated code index (CodeIntel). Kept on disk, never versioned: 13 tracked
# blobs weighing ~35 MB meant every `git status` and every commit draft walked
# and read them on the I: SMR platter (owner order 2026-11-21: reduce disk ops).
.codeintel/

# The watcher governor rewrites this inside the repo on every tick; versioning
# it made a generated state file part of every status and commit walk.
.steady-watcher.json

# Separate projects kept locally, not part of the Kick Overlay repo
cookie-extension/
instagram-followguard/
_scratch/

# The governor's own project marker (written by I:/!watcher tools/project_prep.py).
# It is derived state about this checkout, not product state, and it must not make
# the SIM gate refuse a commit that changed nothing in the repo.
.watcher-project.toml
